<Description>
<![CDATA[Receita em uso (copiada no inicio da batelada)]]>
</Description>
<Data Format="L5K">
<![CDATA[[0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000,0.00000000e+000]]]>
</Data>
</Tag>
